  if(typeof p.password!=='string'||hash_('mt-reviewer:'+p.password)!=='KIbAJxmy0WVkKO1mKuVY9spIo9UW/zFbJnPwblm5Sk4=')throw Error('Password penguji salah.');
  var user={userId:'SHARED_REVIEWER',nama:'Penguji',role:'Penguji'},token=Utilities.getUuid()+Utilities.getUuid();
  cache.put('mt-session:'+token,JSON.stringify(user),3600);cache.remove(rateKey);return {user:user,token:token};
}

