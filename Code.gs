  if(!s){
    s=db.insertSheet('MT_TestPieces');s.appendRow(['TestPieceID','Keterangan','CreatedBy','CreatedAt']);s.setFrozenRows(1);
    var existing=db.getSheetByName('MT_Records'),ids={};
