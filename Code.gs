  var id=String(p.id||'').trim().toUpperCase(),label=String(p.label||'').trim();
  if(!/^[A-Z0-9][A-Z0-9 _./-]{0,79}$/.test(id)||label.length>200)throw Error('Isi Test Piece ID yang valid (maksimal 80 karakter) dan keterangan maksimal 200 karakter.');
  var lock=LockService.getScriptLock();lock.waitLock(30000);try{
    if(catalogRows_('pieces',true).some(function(piece){return piece.id===id;}))throw Error('Test Piece ID sudah terdaftar.');
    pieceSheet_().appendRow([id,label,u.userId,new Date().toISOString()]);SpreadsheetApp.flush();return {id:id,label:label};
  }finally{lock.releaseLock();}
