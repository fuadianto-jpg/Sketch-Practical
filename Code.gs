function adminList_(u){staffOnly_(u);return {pieces:catalogRows_('pieces',false),batches:catalogRows_('batches',false),keys:rows_().filter(function(r){return r.kind==='master'&&r.status!=='Deleted';}).map(function(r){return meta_(r,u);}).reverse(),reports:rows_().filter(function(r){return r.kind==='student'&&r.status!=='Deleted';}).map(function(r){return meta_(r,u);}).reverse()};}
function cellText_(s){return /^[=+@-]/.test(s)?"'"+s:s;}
function editCatalog_(u,p){staffOnly_(u);if(['save','delete'].indexOf(p.operation)<0)throw Error('Operasi tidak tersedia. Data yang dihapus tidak dapat dipulihkan.');var lock=LockService.getScriptLock();lock.waitLock(30000);try{var sheet=catalogSheet_(p.kind),values=sheet.getDataRange().getValues(),idx=values.findIndex(function(r,i){return i>0&&String(r[0])===p.id&&!r[4];});if(idx<1)throw Error('Data tidak ditemukan.');var row=values[idx];if(String(row[5]||'')!==String(p.version||''))throw Error('Data berubah. Muat ulang sebelum mengedit.');if(p.operation==='delete'){if(p.confirmDelete!==true)throw Error('Konfirmasi hapus permanen diperlukan.');sheet.deleteRow(idx+1);SpreadsheetApp.flush();return {id:p.id,deleted:true};}var id=String(p.newId||p.id).trim().toUpperCase(),label=String(p.label==null?row[1]:p.label).trim();if(!/^[A-Z0-9][A-Z0-9 _./-]{0,79}$/.test(id)||label.length>200)throw Error('Kode atau keterangan tidak valid.');if(id!==p.id){if(values.some(function(r,i){return i>0&&String(r[0])===id;}))throw Error('Kode sudah digunakan.');if(rows_().some(function(r){return (p.kind==='pieces'?r.piece:r.batch)===p.id;}))throw Error('Kode sudah dipakai laporan. Kode tetap; ubah keterangan/nama atau tambahkan kode baru.');}var version=Utilities.getUuid();sheet.getRange(1,5,1,2).setValues([['DeletedAt','Version']]);sheet.getRange(idx+1,1,1,6).setValues([[id,cellText_(label),row[2],row[3],'',version]]);SpreadsheetApp.flush();return {id:id,label:label,version:version};}finally{lock.releaseLock();}}
function editReport_(u,p){staffOnly_(u);var lock=LockService.getScriptLock();lock.waitLock(30000);try{var rows=rows_(),idx=rows.findIndex(function(r){return r.id===p.id&&r.kind==='student';}),r=rows[idx];if(!r||r.status==='Deleted')throw Error('Laporan tidak tersedia.');if(r.revision!==p.revision)throw Error('Laporan berubah. Muat ulang sebelum mengedit.');var name=participantName_(p.nama),batch=String(p.batch||'').trim().toUpperCase(),piece=String(p.piece||'').trim().toUpperCase(),method=p.method;if(['Magnetic Particle Testing','Penetrant Testing'].indexOf(method)<0)throw Error('Metode tidak valid.');if(batch!==r.batch&&!batchRows_().some(function(b){return b.id===batch;}))throw Error('Pilih batch yang terdaftar.');if(piece!==r.piece&&!pieceRows_().some(function(b){return b.id===piece;}))throw Error('Pilih Test Piece yang terdaftar.');var d=document_(r),changed=piece!==r.piece||method!==r.method,now=new Date().toISOString();d.batch=batch;d.piece=piece;d.method=method;d.author=d.author||{userId:r.userId};d.author.nama=name;d.adminEdit={by:u.userId,at:now,previousFile:r.fileId};var revision=r.revision+1,file=folder_().createFile(Utilities.newBlob(JSON.stringify(d),'application/json',r.id+'-r'+revision+'.json'));var keyId=changed?'':r.keyId,status=changed&&r.status==='Reviewed'?'Submitted':r.status,evaluation=changed?null:r.evaluation;sheet_().getRange(idx+2,1,1,17).setValues([[r.id,r.userId,r.kind,piece,status,revision,file.getId(),keyId,r.created,now,r.requestId,evaluation?JSON.stringify(evaluation):'',cellText_(name),method,batch,'','']]);sheet_().getRange(1,16,1,2).setValues([['DeletedStatus','DeletedAt']]);SpreadsheetApp.flush();return meta_({id:r.id,userId:r.userId,kind:r.kind,piece:piece,batch:batch,method:method,nama:name,status:status,revision:revision,keyId:keyId,updated:now,evaluation:evaluation},u);}finally{lock.releaseLock();}}
function deleteRecord_(u,p){staffOnly_(u);if(p.operation!=='delete'||p.confirmDelete!==true)throw Error('Konfirmasi hapus permanen diperlukan. Pemulihan tidak tersedia.');var lock=LockService.getScriptLock();lock.waitLock(30000);try{var rows=rows_(),idx=rows.findIndex(function(r){return r.id===p.id&&r.kind===(p.kind==='master'?'master':'student')&&r.status!=='Deleted';}),r=rows[idx];if(!r)throw Error('Data tidak ditemukan.');if(r.revision!==p.revision)throw Error('Data berubah. Muat ulang sebelum menghapus.');if(r.kind==='master'&&rows.some(function(other){return other.kind==='student'&&other.keyId===r.id&&other.status!=='Deleted';})){var refs=keyReferenceSheet_();if(!keySnapshot_(r.id))refs.appendRow([r.id,JSON.stringify(r)]);}deletedRequestSheet_().appendRow([r.userId,r.requestId,r.id]);sheet_().deleteRow(idx+2);SpreadsheetApp.flush();return {id:r.id,deleted:true};}finally{lock.releaseLock();}}

function reviseKey_(u,p){staffOnly_(u);var r=rows_().find(function(r){return r.id===p.id&&r.kind==='master'&&r.status!=='Deleted';});if(!r||r.revision!==p.revision)throw Error('Kunci berubah atau tidak tersedia. Muat ulang dahulu.');if(r.status==='Draft'&&r.userId===u.userId)return load_(u,r.id);var d=document_(r);d.revises=r.id;var draft=save_(u,{kind:'master',final:false,document:d,requestId:p.requestId,sourceRevision:p.revision});return load_(u,draft.id);}

function keyReferenceSheet_(){var db=db_(),s=db.getSheetByName('MT_KeyReferences');if(!s){s=db.insertSheet('MT_KeyReferences');s.appendRow(['KeyID','HistoricalReference']);s.setFrozenRows(1);}return s;}
function keySnapshot_(id){var s=db_().getSheetByName('MT_KeyReferences');if(!s)return null;var row=s.getDataRange().getValues().slice(1).find(function(r){return r[0]===id;});return row?JSON.parse(row[1]):null;}
function reviewKey_(rows,r,id){var key;if(r.keyId){key=rows.find(function(k){return k.id===r.keyId;})||keySnapshot_(r.keyId);}else if(id){key=rows.find(function(k){return k.id===id;});}else{key=rows.slice().reverse().find(function(k){return k.kind==='master'&&k.status==='Published'&&k.piece===r.piece&&k.method===r.method;});}if(!key||key.kind!=='master'||key.piece!==r.piece||key.method!==r.method||!(key.status==='Published'||(r.keyId===key.id&&key.status==='Deleted'&&key.deletedStatus==='Published')))return null;return key;}

function deletedRequestSheet_(){var db=db_(),s=db.getSheetByName('MT_DeletedRequests');if(!s){s=db.insertSheet('MT_DeletedRequests');s.appendRow(['UserID','RequestID','RemovedID']);s.setFrozenRows(1);}return s;}
function isDeletedRequest_(userId,requestId){var s=db_().getSheetByName('MT_DeletedRequests');return !!s&&s.getDataRange().getValues().slice(1).some(function(r){return r[0]===userId&&r[1]===requestId;});}
