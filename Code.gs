function participant_(p){
  var resume=typeof p.resumeKey==='string'?p.resumeKey:'',user=null;
  if(resume&&!/^[a-zA-Z0-9-]{60,100}$/.test(resume))throw Error('Kunci pemulihan tidak valid.');
  var lock=LockService.getScriptLock();lock.waitLock(30000);
  try{
    var db=db_(),sheet=db.getSheetByName('MT_Participants');
    if(!sheet){sheet=db.insertSheet('MT_Participants');sheet.appendRow(['ResumeHash','UserID','Nama','Created']);sheet.setFrozenRows(1);}
    var rows=sheet.getDataRange().getValues(),digest=resume?hash_(resume):'',found=resume?rows.slice(1).find(function(r){return r[0]===digest;}):null;
    if(found)user={role:'Peserta',guest:true,userId:String(found[1]),nama:String(found[2])};
    if(!user&&p.token){var cached=CacheService.getScriptCache().get('mt-session:'+p.token);if(cached){var previous=JSON.parse(cached);if(previous.guest&&previous.role==='Peserta')user=previous;}}
    if(!user)user={role:'Peserta',guest:true,userId:'guest-'+Utilities.getUuid(),nama:participantName_(p.nama)};
    if(resume&&!found)sheet.appendRow([digest,user.userId,user.nama,new Date().toISOString()]);
    var token=Utilities.getUuid()+Utilities.getUuid();CacheService.getScriptCache().put('mt-session:'+token,JSON.stringify(user),21600);return {user:user,token:token};
  }finally{lock.releaseLock();}
}

